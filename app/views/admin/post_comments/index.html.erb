<div class="container my-4">
  <h2>コメント一覧</h2>
  <% @posts.each do |post| %>
    <% post.post_comments.each do |post_comment| %>
      <div class="card mb-3 shadow-sm border-0 bg-light">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="d-flex align-items-center gap-2">
              <%= link_to admin_dashboard_path(post_comment.user.id) do %>
                <%= image_tag post_comment.user.get_profile_image(40,40), class: "rounded-circle border" %>
              <% end %>
              <div>
                <strong class="d-block text-dark"><%= post_comment.user.name %></strong>
                <small class="text-muted"><%= post_comment.created_at.strftime('%Y/%m/%d') %></small>
              </div>
            </div>
            <div>
              <%= link_to "削除", admin_post_post_comment_path(post_comment.post, post_comment),data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-outline-danger btn-sm" %>
            </div>
          </div>
          <p class="card-text text-secondary mb-0 ps-1">
            <%= post_comment.comment %>
          </p>
        </div>
      </div>
    <% end %>
  <% end %>
</div>