<div class="container my-4">
  <h2>全ユーザー一覧</h2>
  <table class="table table-hover align-middle">
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= image_tag user.get_profile_image(100,100) %></td>
          <td><%= user.name %> - <%= user.email_address %></td>
          <td><%= link_to "ユーザー詳細へ", admin_dashboard_path(user.id) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>