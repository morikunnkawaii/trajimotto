<div class="container my-4" style="max-width: 800px;">
  <%# ユーザー情報ヘッダー %>
  <div class="card p-3 mb-4 shadow-sm border-0 bg-light">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <%= image_tag @user.get_profile_image(100,100), class: "rounded-circle border border-2 border-white shadow-sm" %>
        <h3 class="mb-0 fw-bold"><%= @user.name %></h3>
      </div>
      <div>
        <%= link_to '削除', admin_user_path(@user), data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' }, class: "btn btn-outline-danger btn-sm" %>
      </div>
    </div>
  </div>
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0 fw-bold text-secondary">コメント一覧</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <tbody>
          <% @user.post_comments.each do |post_comment| %>
            <tr>
              <td class="ps-3"><%= post_comment.comment %></td>
              <td class="text-end pe-3" style="width: 100px;">
                <%= link_to "削除", admin_post_post_comment_path(post_comment.post, post_comment), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>