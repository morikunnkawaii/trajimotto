<div class="container">
  <div class="row">
    <div class="col-12 text-center">
      <% @posts.each do |post| %>
        <p class="title"><%= post.title %></p>
        <%= image_tag post.get_image(400,400), class: "img-fluid" %>
        <p class="body"><%= post.body %></p>
        <%= post.address %>
        <table class="table w-auto mx-auto">
          <tr>
            <td>
              <%= link_to admin_dashboard_path(post.user.id) do %>
                <%= image_tag post.user.get_profile_image(80,80), class: "rounded-circle shadow-sm", style: "width: 80px; height: 80px; object-fit: cover;" %>
              <% end %>
            </td>
            <td class="align-middle"><%= post.user.name %></td>
            <td>
              <%= link_to "投稿を削除", admin_post_path(post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger"  %>
            </td>
          </tr>
        </table>
      <% end %>
      <%= paginate @posts %>
    </div>
  </div>
</div>