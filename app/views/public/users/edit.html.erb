<div class="container">
  <div class="row">
    <div class="col">
      <h2>プロフィール編集</h2>

      <% if @user.errors.any? %>
        <%= @user.errors.count %>件のエラーが発生しました。必ず全ての投稿項目に記入をお願いします。
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>

      <%= form_with model: @user do |f| %>
        <label for="inputName">ユーザーネーム</label><br>
        <div class="field">
          <%= f.text_field :name, autofocus: true, id:"inputName", placeholder:"名前"%><br>
        </div>
        <label for="inputImage">ユーザーアイコン</label><br>
        <div class="field">
          <%= f.file_field :profile_image, placeholder: "プロフィール画像", accept: "image/*" %><br>
        </div>
        <label for="email">メールアドレス</label><br>
        <div class="field">
          <%= f.text_field :email_address, id:"email",placeholder:"Email_address" %><br>
        </div>
        <div class="field">
          <%= f.submit "変更を保存", class: "btn btn-success" %>
        </div>
        <% if @user == Current.user %>
          <p><%= link_to "退会する", user_path(@user), data: { turbo_method: :delete, turbo_confirm: "本当に退会しますか？" }, class: "btn btn-danger" %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>