<div class="container">
  <div class="row">
    <div class="col">
      <h3><%= @user.name %></h3>
      <%= image_tag @user.get_profile_image(100,100) %>
      <% if @user == Current.user %>
        <p><%= link_to "プロフィール編集", edit_user_path(@user) %></p>
      <% end %>
    </div>
  </div>
</div>

<% @posts.each do |post| %>
  <div class="container">
    <div class="row">
      <div class="col">
        <%= link_to post_path(post.id) do %>
          <%= image_tag post.get_image(400,400) %>
        <% end %>
        <p>タイトル：<%= post.title %></p>
        <p>コメント：<%= post.body %></p>
        <p>ユーザーネーム：<%= post.user.name %></p>
        <p><%= link_to "#{post.post_comments.count} コメント", post_path(post.id) %></p>
      </div>
    </div>
  </div>
<% end %>