<div class="container">
  <div class="row">
    <div class="col">
      <% @users.each do |user| %>
        <%= link_to user_path(user.id) do %>
          <%= image_tag user.get_profile_image(100,100) %>
        <% end %>
        <%= user.name %>
        <p>フォロワー数：<%= user.followers.count %></p>
        <p>フォロー数：<%= user.following.count %></p>
        <%= render "public/users/follow_button", user: user %>
      <% end %>
    </div>
  </div>
</div>