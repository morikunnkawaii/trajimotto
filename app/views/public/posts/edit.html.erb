<div class="container">
  <div class="row">
    <div class="col">
      <h5>編集画面</h5>

      <% if @post.errors.any? %>
        <%= @post.errors.count %>件のエラーが発生しました。必ず全ての投稿項目に記入をお願いします。
        <ul>
          <% @post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>

      <%= form_with model: @post do |f| %>
        <label for="inputImage">投稿画像</label><br>
        <div class="field">
          <%= f.file_field :image, id:"inputImage", placeholder: "投稿画像", accept: "image/*" %>
        </div>
        <label for="title">タイトル</label><br>
        <div class="field">
          <%= f.text_field :title, autofocus: true, id:"title", placeholder: "タイトル", class: "form-control" %>
        </div>
        <label for="body">説明</label><br>
        <div class="field">
          <%= f.text_area :body, id:"body", placeholder: "コメント", rows: 5, class: "form-control" %>
        </div>
        <h6>郵便番号</h6>
        <div class="field">
          <%= text_field_tag :zipcode, nil, id:"zipcode", class: "form-control" %>
        </div>
        <h6>住所</h6>
        <div class="field">
          <%= f.text_field :address, id:"post_address", class: "form-control" %>
        </div>
        <div class="field">
          <%= f.label :tag_list, "タグ（カンマ「,」区切り）", class: "form-label" %>
        </div>
        <div class="field">
          <%= f.label :tag_list, "タグ（カンマ「,」区切り）", class: "form-label" %>
        </div>
        <div class="field">
          <%= f.text_field :tag_list, value: @post.tag_list.to_s, class: "form-control", placeholder: "例: 旅行, カフェ, 温泉" %>
        </div>
        <%= f.submit "変更を保存",class: "btn btn-info text-white" %>
      <% end %>
    </div>
  </div>
</div>
<%= javascript_include_tag "jpostal", 'data-turbo-track': 'reload' %>