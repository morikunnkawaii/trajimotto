<div class="container">
  <div class="row">
    <div class="col">
      <p>タイトル：<%= @post.title %></p>
      <%= image_tag @post.get_image(400,400), class: "img-fluid" %>
      <p class="mt-2">コメント：<%= @post.body %></p>
      <p>
        <%= link_to user_path(@user) do %>
          <%= image_tag @post.user.get_profile_image(80,80), class: "rounded-circle shadow-sm", style: "width: 80px; height: 80px; object-fit: cover;" %>
        <% end %>
      </p>
      <div class="tags mt-2">
        <% @post.tag_list.each do |tag| %>
          <%= link_to tag, posts_path(tag: tag), class: "badge bg-secondary text-decoration-none me-1" %>
        <% end %>
      </div>
      <p class="mt-2">投稿者：<%= @post.user.name %></p>
      <p>投稿日：<%= @post.created_at.strftime('%Y/%m/%d') %></p>
      <% if @post.user == Current.user %>
        <%= link_to "投稿を削除", post_path(@post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger"  %>
        <%= link_to "投稿の編集", edit_post_path(@post), class: "btn btn-info text-white" %>
      <% end %>
    </div>
  </div>
</div>
<div class="container">
  <div class="row">
    <div class="col">
      <p class="mt-2">コメント件数：<%= @post.post_comments.count %></p>
      <% @post_comments.each do |post_comment| %>
        <%= link_to user_path(post_comment.user) do %>
          <p><%= image_tag post_comment.user.get_profile_image(80,80), class: "rounded-circle shadow-sm", style: "width: 80px; height: 80px; object-fit: cover;" %></p>
        <% end %>
        <%= post_comment.user.name %>
        <%= post_comment.created_at.strftime('%Y/%m/%d') %><%= post_comment.comment %>
        <% if post_comment.user == Current.user %>
          <%= link_to "削除", post_post_comment_path(post_comment.post, post_comment), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
        <% end %>
      <% end %>
      <%= paginate @post_comments %>
    </div>
  </div>
</div>
<div class="container">
  <div class="row">
    <div class="col">
      <%= form_with model: [@post, @post_comment] do |f| %>
        <div class="field">
          <%= f.text_area :comment, rows: '5', placeholder: "コメントしよう", class: "form-control" %>
        </div>
        <%= f.submit "送信する" %>
      <% end %>
      <p class="mt-1"><%= render 'favorite', post: @post %></p>
      <%= @post.address %>
    </div>
  </div>
</div>
<div class="container">
  <div id="map" 
       data-api-key="<%= ENV['Maps_API_Key'] %>"
       data-latitude="<%= @post.latitude %>"
       data-longitude="<%= @post.longitude %>"
       data-title="<%= @post.title %>"
       style="width: 100%; height: 400px;">
  </div>
</div>

<%= javascript_include_tag 'map', 'data-turbo-track': 'reload' %>