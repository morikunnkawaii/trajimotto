<div class="container">
  <div class="row">
    <div class="col">
      <h4>さあ投稿しよう！</h4>

      <% if @post.errors.any? %>
        <%= @post.errors.count %>件のエラーが発生しました。必ず全ての投稿項目に記入をお願いします。
        <ul>
          <% @post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>

      <%= form_with model: @post do |f| %>
        <h6>画像</h6>
        <div class="field">
          <%= f.file_field :image, accept: "image/*" %>
        </div>
        <h6>タイトル</h6>
        <div class="field">
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <h6>説明</h6>
        <div class="field">
          <%= f.text_area :body, rows: 5, class: "form-control" %>
        </div>
        <%= f.submit '投稿', class: "btn btn-info text-white" %>
      <% end %>
    </div>
  </div>
</div>
