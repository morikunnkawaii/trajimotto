<div class="container">
  <div class="row">
    <div class ="col-12 text-center">
      <% @favorites.each do |favorite| %>
        <div>
          <p class="title"><%= favorite.post.title %></p>
          <%= link_to post_path(favorite.post.id) do %>
            <%= image_tag favorite.post.get_image(400,400) %>
          <% end %>
          <p class="body"><%= favorite.post.body %></p>
          <table class="table w-auto mx-auto">
            <tr>
              <td>
                <%= link_to user_path(favorite.post.user_id) do %>
                  <%= image_tag favorite.post.user.get_profile_image(80,80) %>
                <% end %>
              </td>
              <td class="align-middle"><%= favorite.post.user.name %></td>
            </tr>
            </table>
          <p><%= link_to "#{favorite.post.post_comments.count} コメント", post_path(favorite.post.id), class: "btn btn-secondary" %></p>
          </div>
          <%= render 'public/posts/favorite', post: favorite.post %>
      <% end %>
    </div>
  </div>
</div>