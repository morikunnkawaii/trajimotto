<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin - Trajimotto" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if authenticated_admin? %>
      <nav class="navbar navbar-expand-lg border border-2 border-success bg-success-subtle">
        <div class="container-fluid">
          <a class="navbar-brand text-danger">管理画面</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
              <li class="nav-item">
                <%= link_to 'ログアウト', admin_session_path, data: { turbo_method: :delete, turbo_confirm: "ログアウトしますか？" }, class:"nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "ユーザー一覧", admin_dashboards_path, class:"nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "コメント一覧", admin_post_comments_path, class:"nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "投稿一覧", admin_posts_path, class:"nav-link" %>
              </li>
            </ul>
          </div>
        </div>
      </nav>
    <% end %>
    <div class="container mt-3">
      <p><%= flash[:notice] %></p>
      <%= yield %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  </body>
</html>