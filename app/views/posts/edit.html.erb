<h2>投稿編集</h2>

<% if @post.errors.any? %>
  <%= @post.errors.count %>件のエラーが発生しました。必ず全ての投稿項目に記入をお願いします。
  <ul>
    <% @post.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @post do |f| %>
  <label for="inputImage">投稿画像</label>
  <%= f.file_field :image, placeholder: "投稿画像", accept: "image/*" %>
  <label for="title">タイトル</title>
  <%= f.text_field :title, autofocus: true, id:"title", placeholder: "タイトル" %>
  <label for="body">説明</label>
  <%= f.text_area :body, id:"body", placeholder: "コメント" %>
  <%= f.submit "変更を保存" %>
<% end %>