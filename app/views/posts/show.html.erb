<div>
  <%= image_tag @post.get_image %>
  <p>タイトル：<%= @post.title %></p>
  <p>コメント：<%= @post.body %></p>
  <p>投稿ユーザー画像：<%= image_tag 'sample-author1.jpg' %></p>
  <p>ユーザーネーム：<%= @post.user.name %></p>
  <p>投稿日：<%= @post.created_at.strftime('%Y/%m/%d') %></p>
  <% if @post.user == Current.user %>
    <%= link_to "削除", post_path(@post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
  <% end %>
</div>
