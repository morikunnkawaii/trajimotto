<div>
  <p>タイトル：<%= @post.title %></p>
  <%= image_tag @post.get_image(400,400) %>
  <p>コメント：<%= @post.body %></p>
  <p>
    <%= link_to user_path(@user) do %>
      <%= image_tag @post.user.get_profile_image(100,100) %>
    <% end %>
  </p>
  <p>投稿者：<%= @post.user.name %></p>
  <p>投稿日：<%= @post.created_at.strftime('%Y/%m/%d') %></p>
  <% if @post.user == Current.user %>
    <%= link_to "投稿を削除", post_path(@post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
    <%= link_to "投稿の編集", edit_post_path(@post) %>
  <% end %>
</div>
